{
  "name": "PDFMy",
  "short_name": "PDFMy",
  "description": "Briefe scannen, als durchsuchbares PDF ablegen und bearbeiten – lokal, ohne Upload.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#DDE5DC",
  "theme_color": "#4B2FBF",
  "icons": [
    {
      "src": "icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "PDF-Dokument",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "name": "Bild",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "shortcuts": [
    { "name": "Mit Kamera scannen", "short_name": "Scannen", "description": "Kamera mit automatischer Blatterkennung – mehrere Seiten am Stück", "url": "./?start=cam" },
    { "name": "PDFs zusammenfügen", "short_name": "Zusammenfügen", "description": "Mehrere Dateien zu einer PDF", "url": "./?start=merge" },
    { "name": "PDF bearbeiten", "short_name": "Bearbeiten", "description": "PDF, Word, Excel oder Bild öffnen und bearbeiten", "url": "./?start=open" },
    { "name": "PDF verkleinern", "short_name": "Verkleinern", "description": "Dateigröße reduzieren", "url": "./?start=compress" },
    { "name": "Unterschreiben", "short_name": "Unterschreiben", "description": "Unterschrift zeichnen und platzieren", "url": "./?start=sign" },
    { "name": "Text erkennen (OCR)", "short_name": "Text erkennen", "description": "Fotos und Scans in durchsuchbares PDF umwandeln", "url": "./?start=scan" },
    { "name": "E-Rechnung schreiben", "short_name": "E-Rechnung", "description": "ZUGFeRD oder XRechnung erstellen", "url": "./?start=einv" }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "dateien",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/png",
            ".png",
            "image/heic",
            ".heic",
            "image/tiff",
            ".tif",
            ".tiff",
            "image/webp",
            ".webp"
          ]
        }
      ]
    }
  }
}
