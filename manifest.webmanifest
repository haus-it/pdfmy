{
  "name": "PDFMy",
  "short_name": "PDFMy",
  "description": "Briefe scannen, als durchsuchbares PDF ablegen und bearbeiten – lokal, ohne Upload.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F6F8",
  "theme_color": "#4A5280",
  "icons": [
    {
      "src": "icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "PDF-Dokument",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "name": "Bild",
      "accept": {
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
