{
  "manifest_version": 3,
  "name": "PDFMy – PDFs direkt öffnen",
  "short_name": "PDFMy",
  "version": "1.0.1",
  "description": "Öffnet PDFs aus dem Browser mit einem Klick in PDFMy – statt im Adobe-Viewer. Lokal, ohne Upload. Powered by Mentor Group.",
  "homepage_url": "https://pdfmy.de/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "PDFMy",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "contextMenus", "storage", "webRequest"],
  "host_permissions": ["https://pdfmy.de/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["https://pdfmy.de/*"], "js": ["pdfmy-bridge.js"], "run_at": "document_start" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
