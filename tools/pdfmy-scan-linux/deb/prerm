# pdfmy Scan (.deb) – vor dem Entfernen: Scan-Dienst für alle Benutzer abmelden und stoppen. Bei einer Aktualisierung
# nicht (postinst startet ihn danach neu). Einstellungen im Benutzerordner bleiben (wie bei Paketen üblich).
set -e
case "$1" in
  remove|purge|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --global disable pdfmy-scan.service >/dev/null 2>&1 || true
      for r in /run/user/*; do
        uid=${r##*/}
        case "$uid" in ''|*[!0-9]*) continue;; esac
        [ "$uid" -ge 1000 ] && [ -S "$r/bus" ] || continue
        n=$(getent passwd "$uid" | cut -d: -f1); [ -n "$n" ] || continue
        runuser -u "$n" -- env XDG_RUNTIME_DIR="$r" DBUS_SESSION_BUS_ADDRESS="unix:path=$r/bus" systemctl --user stop pdfmy-scan.service >/dev/null 2>&1 || true
      done
    fi
    ;;
esac
exit 0
