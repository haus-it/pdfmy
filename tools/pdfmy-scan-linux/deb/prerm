# pdfmy Scan (Paket: .deb, .rpm, Arch) – vor dem Entfernen: Scan-Dienst für alle Benutzer abmelden und stoppen. Bei einer Aktualisierung
# nicht (postinst startet ihn danach neu). Einstellungen im Benutzerordner bleiben (wie bei Paketen üblich).
set -e
case "$1" in
  remove|purge|deconfigure)
    # Rechtsklick-Einträge der Dateimanager, die der Dienst je Benutzer angelegt hat (ab 1.9.0) – nur die eigenen Dateien
    for h in $(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $6 }'); do
      [ -d "$h" ] || continue
      for t in merge compress; do
        rm -f "$h/.local/share/nemo/actions/pdfmy-$t.nemo_action" "$h/.local/share/kio/servicemenus/pdfmy-$t.desktop" "$h/.local/share/kservices5/ServiceMenus/pdfmy-$t.desktop"
      done
      for d in "$h/.local/share/nautilus/scripts" "$h/.config/caja/scripts"; do
        rm -f "$d/In PDFMy zusammenfügen" "$d/Mit PDFMy verkleinern" "$d/Combine in PDFMy" "$d/Compress with PDFMy"
      done
    done
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --global disable pdfmy-scan.service >/dev/null 2>&1 || true
      for r in /run/user/*; do
        uid=${r##*/}
        case "$uid" in ''|*[!0-9]*) continue;; esac
        [ "$uid" -ge 1000 ] && [ -S "$r/bus" ] || continue
        n=$(getent passwd "$uid" | cut -d: -f1); [ -n "$n" ] || continue
        runuser -u "$n" -- env XDG_RUNTIME_DIR="$r" DBUS_SESSION_BUS_ADDRESS="unix:path=$r/bus" systemctl --user stop pdfmy-scan.service >/dev/null 2>&1 || true
      done
    fi
    ;;
esac
exit 0
